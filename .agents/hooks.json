{
  "search-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /workspace/.agents/hooks/search_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "pacific-time-context": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 /workspace/.agents/hooks/time_context.py",
        "timeout": 5
      }
    ]
  }
}
