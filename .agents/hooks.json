{
  "search-safety-gate": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/search_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "tool-batching-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name|run_command|view_file|read_file|replace_file_content|edit_file|write_to_file|write_file|schedule",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/batch_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "pacific-time-context": {
    "enabled": false,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/time_context.py",
        "timeout": 30
      }
    ]
  }
}
