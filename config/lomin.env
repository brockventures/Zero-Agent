# LOMIN Voice Pipeline Environment Configuration for Zero (Port 8771)
MVG_PORT=8771
MVG_BIND=0.0.0.0
MVG_BRAIN=plugin
MVG_PLUGIN=gotchi_zero_adapter
MVG_HTTP_STREAM=1
MVG_BRAIN_DIRECT_AUDIO=1
MVG_DIRECT_AUDIO=1
GOTCHI_ZERO_MODEL=gemini-3.8-flash
MVG_TTS=gemini
MVG_TTS_CHAIN=gemini,piper
MVG_GEMINI_VOICE=Schedar
MVG_ENABLE_VISION=1
MVG_VISION_ENABLED=1
MVG_ENABLE_ADPCM=1
MVG_ADPCM_ENABLED=1
MVG_VISION_ADPCM=1
MVG_HA_FASTPATH=1
MVG_HA_ENABLED=1
MVG_ENABLE_MIC_REOPEN=1
MVG_MIC_REOPEN_ENABLED=1
MVG_ENABLE_DEFER=1
MVG_DEFER_ENABLED=1
GOTCHI_BRAIN_MODE=api
GOTCHI_CONTEXT_CACHE_ENABLED=1
GOTCHI_CONTEXT_CACHE_TTL_SEC=3600
