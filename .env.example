# ==============================================================================
# Zero Autonomous Discord Agent Environment Template
# ==============================================================================

# --- Discord Bot Configuration ---
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CHANNEL_ID="123456789012345678"
DISCORD_OWNER_ID="123456789012345678"
AGY_PRINT_TIMEOUT="30m"

# --- LLM / Agent Model ---
ACTIVE_MODEL="gemini-3.7-flash-high"

# --- Headless Browser (Browserless) ---
BROWSERLESS_URL="http://localhost:3000"

# --- Homelab & Host Parameters (Optional) ---
NAS_HOST_1_IP="127.0.0.1"
NAS_HOST_2_IP="127.0.0.1"
NAS_HOST_2_NAME="PrimaryHost"
NAS_SSH_PORT="22"
NAS_SSH_USER="admin"
NAS_SSH_KEY="/root/.ssh/id_rsa"
NAS_COMPOSE_ROOT="/docker/"

# --- Home Assistant & Media Stack (Optional) ---
HA_BASE_URL="http://localhost:8123"
HA_ACCESS_TOKEN=""
TAUTULLI_URL="http://localhost:8181/api/v2"
TAUTULLI_API_KEY=""
DISCORD_PLEX_WEBHOOK_URL=""

# --- Secrets Paths ---
GOOGLE_OAUTH_PATH="/secrets/google_oauth.json"
HA_SECRETS_PATH="/secrets/ha.json"
